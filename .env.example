# Intelligent Patch Automation - Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# Every setting, its default and the command that applies it: docs/deploying.md#configuration-reference
#
# IMPORTANT: Replace placeholder values with your own AWS account details.
# This solution is account and region agnostic. It works in any AWS account
# with the required services enabled (Bedrock, SSM, Inspector, ECS).

# AWS Configuration (required)
# Set to your AWS CLI named profile and target region.
# The profile must have permissions for Bedrock, SSM, EC2, S3, ECS, and Inspector.
AWS_PROFILE=default
AWS_REGION=us-east-1
# When the shell's AWS_PROFILE differs from this file, deploy.sh asks you to type the
# target account. For unattended runs, set the account ID you expect instead:
# PATCHY_CONFIRM_ACCOUNT=111111111111

# TLS certificate (set one: the deploy stops without a certificate when Cognito is on)
# Use an ACM certificate browsers trust for anything beyond a demo.
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:111111111111:certificate/...
# For a demo, allow deploy.sh to generate (setup-tls.sh) and use a self-signed certificate.
# Without this, a missing or self-signed certificate stops the deploy.
# ALLOW_SELF_SIGNED_CERT=true

# Container Runtime (optional)
# CDK builds the UI container image locally. Docker or Finch required.
# If using Finch instead of Docker, deploy.sh auto-detects it, or set explicitly:
# CDK_DOCKER=finch

# AgentCore Role ARN (auto-detected after first agent deploy)
# deploy.sh reads it from the AgentCore CLI's deployed state. Set it manually only
# if that lookup fails; it must be a role ARN in this account.
# AGENTCORE_ROLE_ARN=

# Existing VPC (optional)
# Set this to use your own VPC instead of creating a new one.
# The VPC needs private subnets with NAT (PRIVATE_WITH_EGRESS) for Fargate.
# When set, the Patchy-Network stack is skipped entirely.
# EXISTING_VPC_ID=vpc-0123456789abcdef0

# Agent Configuration
AGENT_NAME=patchy
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5       # Override the default model
# THINKING_EFFORT=medium                              # low, medium or high (Claude Sonnet 5 and 6)
# PATCHY_DEBUG_LOGS=true    # Logs full prompts, tool inputs/outputs and conversations to
#                           # CloudWatch at DEBUG. For troubleshooting only.

# Instance Scope (security)
# Only instances with this tag can be discovered, scanned, or patched by the agent.
# The spoke role's IAM policy also requires the tag on the instances ssm:SendCommand targets.
# Default: PatchAutomation=enabled
SSM_SCOPE_TAG_KEY=PatchAutomation
SSM_SCOPE_TAG_VALUE=enabled

# Inspector Scope (optional)
# Controls which resource types the agent scans for vulnerabilities.
# Default: EC2 only. For ECS/EKS customers, add ECR to include container image findings.
# Valid values (comma-separated): EC2, ECR, LAMBDA
# INSPECTOR_RESOURCE_TYPES=EC2
# INSPECTOR_RESOURCE_TYPES=EC2,ECR  # Uncomment for container workloads

# Change controls (optional, all off by default)
# CHANGE_CALENDAR=patchy-freeze                # SSM Change Calendar; no plans or runs while it's closed
# ABORT_ALARMS=app-health                      # One CloudWatch alarm (use a composite alarm for several) that stops a run
# REQUIRE_STAGED_ROLLOUT=true                  # staging needs a verified dev run, prod a verified staging run
# REBOOT_POLICY=dev=RebootIfNeeded,staging=RebootIfNeeded   # environments not listed don't reboot unless asked

# Web UI Authentication
# With Cognito (the default, see below), roles come from the Cognito groups and the
# API_KEY* settings are ignored. With COGNITO_ENABLED=false:
#   - API keys: deploy.sh stores them in the Secrets Manager secret patchy/ui-api-keys
#     and the UI task reads them from there. The browser asks for the key.
#   - No keys: every caller gets DEFAULT_ROLE (viewer unless set).
# Set DEFAULT_ROLE=operator only for a trusted pilot behind the internal ALB.
# DEFAULT_ROLE=operator
# API_KEY=              # Single key, operator role (backward compatible)
# API_KEY_OPERATOR=     # Explicit operator key (full access: dashboard + chat + patching)
# API_KEY_VIEWER=       # Viewer key (read-only: dashboard + health only, no chat)
# PUBLIC_URL=https://patchy.example.com   # Address users browse to, for a custom domain (sign-out and callback URL)

# Change approval (optional)
# Patch, rollback and window requests return a plan an operator approves in the UI.
# Set true so the operator who asked for a plan can't approve it (two-person control).
# Needs Cognito: API keys and DEFAULT_ROLE give everyone the same identity.
# REQUIRE_SEPARATE_APPROVER=true

# Runtime authorisation (optional)
# iam (default): the UI calls the runtime with its task role.
# jwt: the runtime accepts only the signed-in user's Cognito access token, binds each
# conversation to that user and checks their group itself. Needs Cognito.
# RUNTIME_AUTH=jwt

# Cognito Authentication (on by default; needs ACM_CERTIFICATE_ARN or ALLOW_SELF_SIGNED_CERT)
# The ALB becomes internet-facing and requires Cognito login.
# Domain prefix is auto-derived from your account ID (patchy-<account_id>) if not set.
# Override here if you need a custom prefix (must be globally unique).
# COGNITO_DOMAIN_PREFIX=patchy-mycompany
# COGNITO_MFA=optional     # off (default), optional or required (required only at pool creation)
#
# To disable Cognito and use internal ALB + bastion host instead:
# COGNITO_ENABLED=false

# Run notifications (optional)
# NOTIFY_TOPIC=true                  # SNS topic that receives each run's outcome
# NOTIFY_EMAIL=ops@example.com       # Subscribed to the topic (confirm the email SNS sends)
# NOTIFY_KMS=true                    # Encrypt the topic and the UI and report Lambda log groups with a customer managed key

# Multi-Account/Region (optional)
# Enable cross-account operations via STS assume-role and SSM TargetLocations.
# Requires the spoke IAM roles (deployed via StackSet) in each target account.
# MULTI_ACCOUNT_ENABLED=true
# SPOKE_EXECUTION_ROLE=PatchySpokeRole  # IAM role name in spoke accounts
# SPOKE_READ_ROLE=PatchySpokeReadRole  # read-only role in spoke accounts, assumed by the dashboard
# AWS_ORG_ID=o-xxxxxxxxxx              # REQUIRED when MULTI_ACCOUNT_ENABLED=true.
#                                       # Cross-account assume-role grants require the target
#                                       # role to be in this organisation (aws:ResourceOrgID),
#                                       # and the bucket policy lets its instances read overrides.
#                                       # Get it: aws organizations describe-organization \
#                                       #         --query 'Organization.Id' --output text
# SPOKE_REGIONS=us-east-1              # Comma-separated. Defaults to AWS_REGION if unset.
#                                       # StackSet deploys Automation docs to each region.
#                                       # Inspector must be enabled in each target region.
#
# Spoke targets (set one; with multi-account on and neither set, no accounts are in scope):
# SPOKE_ACCOUNT_IDS=111111111111,222222222222  # Explicit accounts; include the hub
# SPOKE_OU_IDS=ou-abc123,ou-def456            # Service-managed StackSet: auto-deploys to new accounts in OUs
# If neither is set, ./deploy.sh spoke prompts interactively (with org auto-discover option).
# When set, full deploy (./deploy.sh) auto-includes spoke deployment.

# Sample environment spoke targets (optional, used by ./sample-env.sh):
# Comma-separated account IDs to deploy sample EC2 instances to.
# Defaults to the first account in SPOKE_ACCOUNT_IDS if not set.
# SAMPLE_ENV_ACCOUNTS=222222222222,333333333333

# AgentCore Observability (optional, both disabled by default)
#
# Two independent layers. Turn on whichever you need.
#
# The runtime's stdout always goes to /aws/bedrock-agentcore/runtimes/<runtime-id>-DEFAULT.
# This adds an APPLICATION_LOGS delivery of per-invocation records to
# /aws/vendedlogs/bedrock-agentcore/<runtime-id>/application_logs (14-day retention).
# ENABLE_RUNTIME_LOGS=true
#
# Tracing: account-level Transaction Search + per-runtime trace span delivery.
# Required to populate the GenAI Observability dashboard with session traces,
# tool spans, and agent decision graphs.
# Spans take ~10 min to start appearing after first enable.
# View at: CloudWatch console → GenAI Observability
# Cost: ~$5 per million spans ingested (default 1% sampling indexed at no cost).
# ENABLE_TRACING=true

# Bedrock Guardrails (optional)
# Run `python agent/setup_guardrail.py` to create a sample guardrail with topic
# filtering, content safety, and sensitive data masking. The script prints the
# values to set here, then redeploy with `./deploy.sh agent`.
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=

# Fleet enrichment cap (optional)
# Most EC2 instances the agent reads per fleet refresh. Defaults to 5000.
# An environment-wide plan is refused when the fleet is bigger, so raise it
# for larger fleets.
# MAX_FLEET_SIZE=5000

# Instance tags recorded in each run's report, comma-separated, up to 10.
# Reports group the SLA summary by the first. Applied by ./deploy.sh agent.
# REPORT_TAGS=Team,Product

# Deploy eval (optional)
# ./deploy.sh agent runs a tool-selection eval of this checkout's prompt and tools first.
# EVAL_THRESHOLD=80     # minimum accuracy, percent
# SKIP_EVAL=true

# Destroy gates (opt-in only, see ./deploy.sh destroy --help)
# DESTROY_SPOKE_STACKSET=true   # Also destroys the Patchy-SpokeIam and Patchy-SsmDocs
#                                  StackSets across every spoke account/region.
#                                  Org-wide blast radius, preserved by default.
# DESTROY_FLEET_SYNC=true       # Also deletes the SSM Resource Data Sync
#                                  ('patchy-fleet-sync'). Re-creation triggers
#                                  a multi-hour ingestion window, preserved
#                                  by default.
# PROJECT_NAME=patchy           # Names the AgentCore stack destroy falls back to
#                                  deleting (AgentCore-<PROJECT_NAME>-default).
