# Intelligent Patch Automation - Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# AWS Configuration (required)
AWS_PROFILE=default
AWS_REGION=us-east-1

# AgentCore Role ARN (auto-detected if not set)
# Only set this if you have multiple AgentCore roles and need to pick one.
# AGENTCORE_ROLE_ARN=

# Existing VPC (optional)
# Set this to use your own VPC instead of creating a new one.
# The VPC needs private subnets with NAT (PRIVATE_WITH_EGRESS) for Fargate.
# When set, the NetworkingStack is skipped entirely.
# EXISTING_VPC_ID=vpc-0123456789abcdef0

# Agent Configuration
AGENT_NAME=intelligent-patch-automation
BYPASS_TOOL_CONSENT=true

# Web UI (optional)
# API_KEY=              # Set to enable API key auth on the web UI

# TLS (optional - run ./setup-tls.sh to generate, or use your own ACM cert)
# ACM_CERTIFICATE_ARN=  # Enables HTTPS on the ALB. Without it, ALB serves HTTP.
