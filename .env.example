# Environment Configuration for Intelligent Patch Automation
# Copy to .env and fill in your values: cp .env.example .env
# Both deploy.sh and chat.sh auto-source .env — no manual exports needed.

# AWS Configuration (required)
AWS_PROFILE=default
AWS_REGION=us-east-1

# AgentCore Role ARN (required for ./deploy.sh infra)
# Find it after first agent deploy:
#   aws iam list-roles --query 'Roles[?starts_with(RoleName,`AmazonBedrockAgentCoreSDKRuntime`)].Arn' --output text
AGENTCORE_ROLE_ARN=

# Agent Configuration (defaults work for most setups)
AGENT_NAME=intelligent-patch-automation
BYPASS_TOOL_CONSENT=true
