# Intelligent Patch Automation — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# Both deploy.sh and chat.sh auto-source .env.

# AWS Configuration (required)
AWS_PROFILE=default
AWS_REGION=us-east-1

# AgentCore Role ARN (required for ./deploy.sh infra or ./deploy.sh solution)
# Deploy agent first, then find the role:
#   aws iam list-roles --query 'Roles[?starts_with(RoleName,`AmazonBedrockAgentCoreSDKRuntime`)].Arn' --output text
AGENTCORE_ROLE_ARN=

# Agent Configuration
AGENT_NAME=intelligent-patch-automation
BYPASS_TOOL_CONSENT=true

# Web UI (optional)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# API_KEY=              # Set to enable API key auth on the web UI
