# Environment Configuration for Intelligent Patch Automation

# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID is resolved dynamically via STS — no need to set it

# Agent Configuration
AGENT_NAME=intelligent-patch-automation
EXECUTION_ROLE_NAME=IntelligentPatchAutomation
ECR_REPO_NAME=intelligent_patch_automation

# AgentCore Configuration
BYPASS_TOOL_CONSENT=true

# Infrastructure Configuration (populated after running ./deploy.sh infra)
# Get these from CDK stack outputs:
#   VPC_ID=<from PatchAutomationNetworking stack output>
#   SECURITY_GROUP_ID=<from PatchAutomationSecurity stack output>
#   INSTANCE_ROLE_ARN=<from PatchAutomationSecurity stack output>
#   AGENT_ROLE_ARN=<from PatchAutomationSecurity stack output>
