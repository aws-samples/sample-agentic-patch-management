# .bedrock_agentcore.yaml.template
# Copy this to .bedrock_agentcore.yaml and update values for your environment

default_agent: ${AGENT_NAME:-intelligent-patch-automation}

agents:
  ${AGENT_NAME:-intelligent-patch-automation}:
    name: ${AGENT_NAME:-intelligent-patch-automation}
    entrypoint: supervisor.py
    platform: linux/arm64
    container_runtime: finch
    
    aws:
      execution_role: arn:aws:iam::${AWS_ACCOUNT_ID}:role/${EXECUTION_ROLE_NAME:-IntelligentPatchAutomation}
      account: '${AWS_ACCOUNT_ID}'
      region: ${AWS_REGION:-us-east-1}
      ecr_repository: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION:-us-east-1}.amazonaws.com/${ECR_REPO_NAME:-intelligent_patch_automation}
      ecr_auto_create: true
      
      network_configuration:
        network_mode: PUBLIC
      
      protocol_configuration:
        server_protocol: HTTP
      
      observability:
        enabled: true
    
    bedrock_agentcore:
      agent_id: # Will be auto-generated
      agent_arn: # Will be auto-generated  
      agent_session_id: # Will be auto-generated
    
    authorizer_configuration: null
